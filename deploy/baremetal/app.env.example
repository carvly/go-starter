# {{name}} 的配置，由 deploy/baremetal/render.sh 生成为 app.env.example，补全后放到 {{conf_dir}}/app.env（属主 root:{{name}}，权限 640）。
# 格式：每行 KEY=VALUE，# 开头为注释；值不加引号、不含反斜杠、行首行尾没有空白、不续行（systemd 的 EnvironmentFile= 与 app-cmd
# 在这个范围内读到的值相同）。不能写单元里用 Environment= 设定的键：APP_ENV、HTTP_TRUSTED_PROXY、HTTP_SOCKET_ACTIVATION、
# HTTP_SHUTDOWN_DRAIN、INSTANCE_ID、HTTP_INTERNAL_ADDR（rollout.sh 会检查）。其余配置项见 configs/.env.example。

# 与 {{name}}-api.socket 的 ListenStream= 一致（进程按地址认领 systemd 传来的 socket）
HTTP_ADDR=127.0.0.1:{{api_port}}
@admin HTTP_ADMIN_ADDR=127.0.0.1:{{admin_port}}
@admin HTTP_ADMIN_ORIGIN=https://{{admin_domain}}
USER_PUBLIC_BASE_URL=https://{{api_domain}}

DB_DSN=postgres://{{name}}:<密码>@<主机>:5432/{{name}}?sslmode=require
REDIS_ADDR=
CORS_ALLOW_ORIGINS=
USER_COOKIE_DELIVERY_ORIGINS=
JWT_SIGNING_KEY=
JWT_KEY_ID=
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
