# {{name}} 的迁移（%i 为版本号），由 render.sh 生成为 {{name}}-migrate@.service：一次性服务，环境变量与 api/worker 一致，
# systemctl start 阻塞到迁移结束并以其退出码返回。由 rollout.sh 调用。
[Unit]
Description={{name}} migrate (%i)

[Service]
Type=oneshot
User={{name}}
Group={{name}}
EnvironmentFile={{conf_dir}}/app.env
# 迁移必须在切换 current 之前用新版本执行，所以按版本号指定路径。systemd 219 不展开可执行文件路径里的 %i，
# 经 /usr/bin/env 转一次：路径成为参数，%i 会展开；env 以 exec 替换自身，进程不变。
ExecStart=/usr/bin/env {{root}}/releases/%i/api migrate up
SyslogIdentifier={{name}}-migrate
TimeoutStartSec=10min
