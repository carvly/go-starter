// 应用机上的 Alloy：抓指标、读 journald 日志、接收 trace 并做尾部采样。见 docs/agents/deploy-ci.md 的"裸机双实例发布"
// 和 docs/agents/observability.md。prometheus.internal、loki.internal、tempo.internal 按实际环境替换。
// Alloy 的运行用户要加入 systemd-journal 组才能读 journald。

// ---------- 指标 ----------
// 每个端口一个 Registry，内容不重叠，5 个端口都要抓：前台（运行时、业务、前台 HTTP 指标）、后台（后台 HTTP 指标）、
// worker（运行时、业务指标）。instance 改成"主机名:端口"：默认是抓取地址 127.0.0.1:端口，多台机器时会互相覆盖。
prometheus.scrape "app" {
	job_name        = "app"
	scrape_interval = "15s"
	targets         = [
		{"__address__" = "127.0.0.1:8080", "instance" = constants.hostname + ":8080"},
		{"__address__" = "127.0.0.1:8081", "instance" = constants.hostname + ":8081"},
		{"__address__" = "127.0.0.1:8082", "instance" = constants.hostname + ":8082"},
		{"__address__" = "127.0.0.1:8083", "instance" = constants.hostname + ":8083"},
		{"__address__" = "127.0.0.1:9090", "instance" = constants.hostname + ":9090"},
	]
	forward_to = [prometheus.remote_write.default.receiver]
}

// Prometheus 开 --web.enable-remote-write-receiver；要从指标跳到 trace 再开 --enable-feature=exemplar-storage。
prometheus.remote_write "default" {
	endpoint {
		url            = "http://prometheus.internal:9090/api/v1/write"
		send_exemplars = true
	}
	external_labels = {env = "production"} // 环境标签在采集端加，应用不输出
}

// ---------- 日志 ----------
// stdout → journald 是唯一事实来源；只收 app-* 的 unit。Loki 标签只放低基数：service_name、level、unit。
loki.source.journal "app" {
	relabel_rules = loki.relabel.journal.rules
	forward_to    = [loki.process.app.receiver]
}

loki.relabel "journal" {
	forward_to = []

	rule {
		source_labels = ["__journal__systemd_unit"]
		regex         = "app-.*\\.service"
		action        = "keep"
	}

	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}
	// 级别取 journald 的 PRIORITY：应用检测到 journald 时给每行加了 syslog 优先级前缀。
	rule {
		source_labels = ["__journal_priority_keyword"]
		target_label  = "level"
	}
}

loki.process "app" {
	stage.json {
		expressions = {service_name = "", trace_id = "", span_id = "", link_trace_id = ""}
	}

	stage.labels {
		values = {service_name = ""}
	}
	// ID 不能当标签：放 structured metadata，Grafana 按 trace_id 从日志跳到 Tempo。
	stage.structured_metadata {
		values = {trace_id = "", span_id = "", link_trace_id = ""}
	}
	forward_to = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		url = "http://loki.internal:3100/loki/api/v1/push"
	}
	external_labels = {env = "production"}
}

// ---------- trace ----------
// 应用设 OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318 后全量导出到这里，由尾部采样决定保留哪些。
// 一条 trace 只出自一个进程（worker 的执行是新 trace，经 link 关联），本机的 Alloy 能看全，不需要按 trace_id 负载均衡。
otelcol.receiver.otlp "app" {
	http {
		endpoint = "127.0.0.1:4318"
	}

	output {
		traces = [otelcol.processor.tail_sampling.app.input]
	}
}

otelcol.processor.tail_sampling "app" {
	decision_wait = "10s"
	// 出错的全保留
	policy {
		name = "errors"
		type = "status_code"

		status_code {
			status_codes = ["ERROR"]
		}
	}
	// 慢的全保留（阈值按业务调整）
	policy {
		name = "slow"
		type = "latency"

		latency {
			threshold_ms = 1000
		}
	}
	// 其余按比例
	policy {
		name = "sample"
		type = "probabilistic"

		probabilistic {
			sampling_percentage = 10
		}
	}

	output {
		traces = [otelcol.exporter.otlp.tempo.input]
	}
}

otelcol.exporter.otlp "tempo" {
	client {
		endpoint = "tempo.internal:4317"

		tls {
			insecure = true
		}
	}
}
