// 全机一份（不随项目渲染）：remote_write、Loki 写入、日志的 JSON 解析、接收 trace 并做尾部采样。各项目的抓取和 journald 读取在
// render.sh 生成的 <项目>.alloy 里，转发到这里的组件；Alloy 以目录方式加载（alloy run /etc/alloy/），各文件合成一份配置。
// 见 docs/agents/deploy-ci.md 的"裸机发布"和 docs/agents/observability.md。prometheus.internal、loki.internal、tempo.internal
// 按实际环境替换。Alloy 的运行用户要加入 systemd-journal 组才能读 journald。

// Prometheus 开 --web.enable-remote-write-receiver；要从指标跳到 trace 再开 --enable-feature=exemplar-storage。
prometheus.remote_write "default" {
	endpoint {
		url            = "http://prometheus.internal:9090/api/v1/write"
		send_exemplars = true
	}
	external_labels = {env = "production"} // 环境标签在采集端加，应用不输出
}

// ---------- 日志 ----------
// stdout → journald 是唯一事实来源；各项目的 <项目>.alloy 按 SYSLOG_IDENTIFIER 读取并打上 project、syslog_identifier、level 标签后
// 转发到这里。Loki 标签只放低基数：project、service_name、level、syslog_identifier。
loki.process "logs" {
	stage.json {
		expressions = {service_name = "", trace_id = "", span_id = "", link_trace_id = "", client_platform = "", client_version = ""}
	}

	stage.labels {
		values = {service_name = ""}
	}
	// ID 不能当标签：放 structured metadata，Grafana 按 trace_id 从日志跳到 Tempo。客户端的端和版本取值多、按需筛选，
	// 同样放 structured metadata，按"某版本的 Android"查日志不必 | json 全量解析。
	stage.structured_metadata {
		values = {trace_id = "", span_id = "", link_trace_id = "", client_platform = "", client_version = ""}
	}
	forward_to = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		url = "http://loki.internal:3100/loki/api/v1/push"
	}
	external_labels = {env = "production"}
}

// ---------- trace ----------
// 应用设 OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318 后全量导出到这里，由尾部采样决定保留哪些。
// 一条 trace 只出自一个进程（worker 的执行是新 trace，经 link 关联），本机的 Alloy 能看全，不需要按 trace_id 负载均衡。
otelcol.receiver.otlp "app" {
	http {
		endpoint = "127.0.0.1:4318"
	}

	output {
		traces = [otelcol.processor.tail_sampling.app.input]
	}
}

otelcol.processor.tail_sampling "app" {
	decision_wait = "10s"
	// 出错的全保留
	policy {
		name = "errors"
		type = "status_code"

		status_code {
			status_codes = ["ERROR"]
		}
	}
	// 慢的全保留（阈值按业务调整）
	policy {
		name = "slow"
		type = "latency"

		latency {
			threshold_ms = 1000
		}
	}
	// 其余按比例
	policy {
		name = "sample"
		type = "probabilistic"

		probabilistic {
			sampling_percentage = 10
		}
	}

	output {
		traces = [otelcol.exporter.otlp.tempo.input]
	}
}

otelcol.exporter.otlp "tempo" {
	client {
		endpoint = "tempo.internal:4317"

		tls {
			insecure = true
		}
	}
}
