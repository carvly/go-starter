package domaintest

import (
	"strconv"
	"strings"
	"sync/atomic"
	"time"
	"uuid"

	"{{.GoMod}}/internal/modules/{{.N.Module}}/domain"
)

var seq atomic.Int64

// Valid{{.N.Type}} 返回一个满足全部约束、每个字段都有值的 {{.N.Type}}，唯一字段每次调用都不同。
// 加字段后在这里补上：契约测试检查没有字段是零值。
func Valid{{.N.Type}}() *domain.{{.N.Type}} {
	n := seq.Add(1)
	return &domain.{{.N.Type}}{
		ID: uuid.NewV7().String(),
{{- range .Fields}}
		{{.Go}}: {{.Sample "" "n"}},
{{- end}}
	}
}
{{if .HasCreate}}
// Valid{{.N.Type}}Create 是用 Valid{{.N.Type}} 的值填的新建请求。
func Valid{{.N.Type}}Create() domain.{{.N.Type}}Create {
	v := Valid{{.N.Type}}()
	return domain.{{.N.Type}}Create{
{{- range .Create}}
		{{.Go}}: v.{{.Go}},
{{- end}}
	}
}
{{end}}
{{- if .HasUpdate}}
// UpdateFrom 是把 v 原样提交的编辑请求。
func UpdateFrom(v *domain.{{.N.Type}}) domain.{{.N.Type}}Update {
	return domain.{{.N.Type}}Update{
{{- range .Update}}
		{{.Go}}: v.{{.Go}},
{{- end}}
		Version: v.Version,
	}
}
{{end}}
// Text 返回长度为 size、随 n 变化的字符串，用于满足长度约束和唯一约束。
func Text(n int64, size int) string {
	s := strconv.FormatInt(n, 36)
	if len(s) < size {
		s = strings.Repeat("a", size-len(s)) + s
	}
	return s[len(s)-size:]
}

// Int 返回 [lo, hi] 内随 n 变化的整数，用于满足范围约束和唯一约束。
func Int(n, lo, hi int64) int64 {
	return lo + n%(hi-lo+1)
}

