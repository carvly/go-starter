// Package postgres 是 {{.N.Module}} 的 Repository 实现（pgx/v5，经 dbtx.Handle 取连接）。
package postgres

import (
	"context"
	"errors"
	"fmt"

	"github.com/jackc/pgx/v5"

	"{{.GoMod}}/internal/kit/page"
	"{{.GoMod}}/internal/modules/{{.N.Module}}/domain"
	"{{.GoMod}}/internal/platform/dbtx"
	platformpg "{{.GoMod}}/internal/platform/postgres"
)

type Repository struct {
	handle *dbtx.Handle
}

func NewRepository(handle *dbtx.Handle) *Repository {
	return &Repository{handle: handle}
}

const columns = `{{.SelectColumns}}`

func scan(row pgx.CollectableRow) (*domain.{{.N.Type}}, error) {
	var v domain.{{.N.Type}}
	err := row.Scan({{.ScanArgs}})
	return &v, err
}

{{if .Unique}}// mapErr 把唯一约束冲突换成领域错误，其余错误包装后返回。{{else}}// mapErr 包装错误。加了唯一约束后在这里按约束名换成领域错误（platformpg.UniqueViolation）。{{end}}
func mapErr(op string, err error) error {
{{- if .Unique}}
	switch platformpg.UniqueViolation(err) {
{{- range .Unique}}
	case "{{$.Constraint .}}":
		return domain.{{.ErrTaken}}
{{- end}}
	}
{{- end}}
	return fmt.Errorf("postgres: %s {{.N.Resource}}: %w", op, err)
}

func (r *Repository) Create(ctx context.Context, v *domain.{{.N.Type}}) error {
	err := r.handle.Resolve(ctx).QueryRow(ctx, `
		INSERT INTO {{.N.Table}} ({{.InsertColumns}}, created_at, updated_at)
		VALUES ({{.InsertPlaceholders}}, now(), now())
		RETURNING {{if .HasUpdate}}version, {{end}}created_at, updated_at
	`, {{.InsertArgs}}).Scan({{if .HasUpdate}}&v.Version, {{end}}&v.CreatedAt, &v.UpdatedAt)
	if err != nil {
		return mapErr("create", err)
	}
	return nil
}

func (r *Repository) GetByID(ctx context.Context, id string) (*domain.{{.N.Type}}, error) {
	rows, err := r.handle.Resolve(ctx).Query(ctx, `SELECT `+columns+` FROM {{.N.Table}} WHERE id = $1`, id)
	if err != nil {
		return nil, fmt.Errorf("postgres: get {{.N.Resource}}: %w", err)
	}
	v, err := pgx.CollectExactlyOneRow(rows, scan)
	if errors.Is(err, pgx.ErrNoRows) {
		return nil, domain.ErrNotFound
	}
	if err != nil {
		return nil, fmt.Errorf("postgres: get {{.N.Resource}}: %w", err)
	}
	return v, nil
}
{{if .Admin}}
func (r *Repository) List(ctx context.Context, f domain.{{.N.Type}}Filter, s page.Sort, p page.Request) (page.Result[*domain.{{.N.Type}}], error) {
	var w platformpg.Where
{{- if .Search}}
	w.Contains(f.Keyword{{range .Search}}, "{{.Name}}"{{end}})
{{- end}}
{{- range .Filters}}
{{- if eq .Type "enum"}}
	w.In("{{.Name}}", strs(f.{{.Go}}))
{{- else if eq .Type "bool"}}
	if f.{{.Go}} != nil {
		w.Eq("{{.Name}}", *f.{{.Go}})
	}
{{- else}}
	w.Range("{{.Name}}", f.{{.Go}}From, f.{{.Go}}To)
{{- end}}
{{- end}}
	return platformpg.ListPage(ctx, r.handle.Resolve(ctx), "{{.N.Table}}", columns, w, s, p, scan)
}
{{- if .HasEnumFilter}}

func strs[T ~string](vs []T) []string {
	out := make([]string, len(vs))
	for i, v := range vs {
		out[i] = string(v)
	}
	return out
}
{{- end}}
{{else}}
// List 多取一行判断是否还有下一页；limit 在这里再兜底一次，避免 items[limit-1] panic。
func (r *Repository) List(ctx context.Context, cursor string, limit int) ([]*domain.{{.N.Type}}, string, error) {
	if limit <= 0 {
		limit = domain.DefaultListLimit
	}
	createdAt, id, hasCursor, err := platformpg.DecodeCursor(cursor)
	if err != nil {
		return nil, "", domain.ErrInvalidCursor
	}
	q := r.handle.Resolve(ctx)
	var rows pgx.Rows
	if hasCursor {
		rows, err = q.Query(ctx, `SELECT `+columns+` FROM {{.N.Table}}
			WHERE (created_at, id) < ($1, $2) ORDER BY created_at DESC, id DESC LIMIT $3`, createdAt, id, limit+1)
	} else {
		rows, err = q.Query(ctx, `SELECT `+columns+` FROM {{.N.Table}}
			ORDER BY created_at DESC, id DESC LIMIT $1`, limit+1)
	}
	if err != nil {
		return nil, "", fmt.Errorf("postgres: list {{.N.Plural}}: %w", err)
	}
	items, err := pgx.CollectRows(rows, scan)
	if err != nil {
		return nil, "", fmt.Errorf("postgres: list {{.N.Plural}}: %w", err)
	}
	next := ""
	if len(items) > limit {
		last := items[limit-1]
		next = platformpg.EncodeCursor(last.CreatedAt, last.ID)
		items = items[:limit]
	}
	return items, next, nil
}
{{end}}
{{- if .HasUpdate}}
// Update 把 version 的比较写进同一条 UPDATE：先读再比较的话，两次请求可能都通过比较。
func (r *Repository) Update(ctx context.Context, id string, in domain.{{.N.Type}}Update) (*domain.{{.N.Type}}, error) {
	q := r.handle.Resolve(ctx)
	rows, err := q.Query(ctx, `
		UPDATE {{.N.Table}} SET {{.UpdateSet}}, version = version + 1, updated_at = now()
		WHERE id = $1 AND version = ${{.UpdateVersionArg}} RETURNING `+columns, id{{range .Update}}, in.{{.Go}}{{end}}, in.Version)
	if err != nil {
		return nil, mapErr("update", err)
	}
	v, err := pgx.CollectExactlyOneRow(rows, scan)
	if err == nil {
		return v, nil
	}
	if !errors.Is(err, pgx.ErrNoRows) {
		return nil, mapErr("update", err)
	}
	// 没有更新：只在失败路径多查一次，区分不存在和已被别人修改。
	ok, err := r.exists(ctx, id)
	if err != nil {
		return nil, err
	}
	if !ok {
		return nil, domain.ErrNotFound
	}
	return nil, domain.ErrConflict
}
{{end}}
{{- if .HasDelete}}
func (r *Repository) Delete(ctx context.Context, id string) error {
	tag, err := r.handle.Resolve(ctx).Exec(ctx, `DELETE FROM {{.N.Table}} WHERE id = $1`, id)
	if err != nil {
		return fmt.Errorf("postgres: delete {{.N.Resource}}: %w", err)
	}
	if tag.RowsAffected() == 0 {
		return domain.ErrNotFound
	}
	return nil
}
{{end}}
{{- range .Actions}}{{if .Declarative}}
// {{.Go}} 是动作"{{.Title}}"：条件和更新在同一条 UPDATE 里，并发下不会在条件不满足时改成功。
func (r *Repository) {{.Go}}(ctx context.Context, id string{{range .Sets}}{{if .Param}}, {{camel .Param.Name}} {{.Param.DomainType}}{{end}}{{end}}) (*domain.{{$.N.Type}}, error) {
	rows, err := r.handle.Resolve(ctx).Query(ctx, `
		{{$.ActionSQL .}} RETURNING `+columns, {{$.ActionArgs .}})
	if err != nil {
		return nil, mapErr("{{.Name}}", err)
	}
	v, err := pgx.CollectExactlyOneRow(rows, scan)
	if err == nil {
		return v, nil
	}
	if !errors.Is(err, pgx.ErrNoRows) {
		return nil, mapErr("{{.Name}}", err)
	}
{{- if .Whens}}
	ok, err := r.exists(ctx, id)
	if err != nil {
		return nil, err
	}
	if ok {
		return nil, domain.ErrInvalidState
	}
{{- end}}
	return nil, domain.ErrNotFound
}
{{end}}{{end}}
{{- if .NeedExists}}
func (r *Repository) exists(ctx context.Context, id string) (bool, error) {
	var ok bool
	err := r.handle.Resolve(ctx).QueryRow(ctx, `SELECT EXISTS(SELECT 1 FROM {{.N.Table}} WHERE id = $1)`, id).Scan(&ok)
	if err != nil {
		return false, fmt.Errorf("postgres: {{.N.Resource}} exists: %w", err)
	}
	return ok, nil
}
{{end}}
var _ domain.Repository = (*Repository)(nil)
