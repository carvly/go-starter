func Test{{pascal .N.OpUpdate}}_Version(t *testing.T) {
	e, svc, repo := newServer(t)
{{- if .HasUpdateRules}}
	probe := domaintest.Valid{{.N.Type}}()
	if err := repo.Create(t.Context(), probe); err != nil {
		t.Fatal(err)
	}
	if _, err := svc.Update(t.Context(), probe.ID, domaintest.UpdateFrom(probe)); errors.Is(err, domain.ErrNotImplemented) {
		t.Skip("rules 还没补足，见 NotImplemented 测试")
	}
{{- end}}
	_ = svc
	v := domaintest.Valid{{.N.Type}}()
	if err := repo.Create(t.Context(), v); err != nil {
		t.Fatal(err)
	}
	req := map[string]any{
{{- range .Update}}
		{{q .Name}}: json.RawMessage(`{{.JSONSample}}`),
{{- end}}
		"version": 1,
	}
	body, _ := json.Marshal(req)
	if code, got := do(t, e, http.MethodPut, prefix+"/"+v.ID, string(body)); code != http.StatusOK || got["version"] != float64(2) {
		t.Fatalf("修改 = %d %v", code, got)
	}
	if code, got := do(t, e, http.MethodPut, prefix+"/"+v.ID, string(body)); code != http.StatusConflict || got["code"] != "{{.N.Resource}}_conflict" {
		t.Errorf("用旧 version 修改 = %d %v, want 409", code, got)
	}
}
{{end}}
