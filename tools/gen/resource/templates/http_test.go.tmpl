// newServer 用真实的{{if .Admin}}后台 {{end}}server（中间件链、校验器、错误处理）挂上本模块的操作。
// 登录{{if .Admin}}和权限{{end}}检查不在这里测，用一个放行的中间件代替。
func newServer(t *testing.T) (*echo.Echo, *domain.Service, *domaintest.Repository) {
	t.Helper()
	repo := domaintest.NewRepository()
	svc := domain.NewService(repo)
	pass := func(next echo.HandlerFunc) echo.HandlerFunc { return next }
{{- if .Admin}}
	e, err := httpserver.NewAdmin(httpserver.AdminDeps{
		Tracer: tracing.Disabled(),
		Logger: slog.New(slog.DiscardHandler),
		HTTP:   config.HTTPConfig{BodyLimitBytes: 1 << 20, RequestTimeout: 5 * time.Second, GlobalRateLimitPerSecond: 1000},
		Origin: "https://admin.example.com",
		Routes: []func(*echo.Group){func(g *echo.Group) { adminapi.Register(g, adminapi.NewHandler(svc)) }},
		Auth:   []echo.MiddlewareFunc{pass},
	})
{{- else}}
	e, err := httpserver.New(httpserver.Deps{
		Tracer: tracing.Disabled(),
		Logger: slog.New(slog.DiscardHandler),
		HTTP:   config.HTTPConfig{BodyLimitBytes: 1 << 20, RequestTimeout: 5 * time.Second, GlobalRateLimitPerSecond: 1000},
		CORS:   config.CORSConfig{AllowOrigins: []string{"https://example.com"}},
		Routes: []func(*echo.Group){func(g *echo.Group) {
			httpapi.Register(g, httpapi.NewHandler(svc){{if .WebAuth}}, httpapi.Middlewares{Auth: pass}{{end}})
		}},
	})
	_ = pass
{{- end}}
	if err != nil {
		t.Fatal(err)
	}
	return e, svc, repo
}

func do(t *testing.T, e *echo.Echo, method, path, body string) (int, map[string]any) {
	t.Helper()
	req := httptest.NewRequest(method, path, strings.NewReader(body))
	if body != "" {
		req.Header.Set(echo.HeaderContentType, echo.MIMEApplicationJSON)
	}
	rec := httptest.NewRecorder()
	e.ServeHTTP(rec, req)
	var m map[string]any
	_ = json.Unmarshal(rec.Body.Bytes(), &m)
	return rec.Code, m
}

const prefix = "{{if .Admin}}/admin/v1{{else}}/v1{{end}}{{.N.Path}}"
{{if .HasCreate}}
// 用全部字段创建，再读出来逐个比较：handler 里请求体到 Service、实体到响应的映射漏了字段，这里失败。
func Test{{pascal .N.OpCreate}}_AllFields(t *testing.T) {
	e, svc, _ := newServer(t)
{{- if .HasNotImplemented}}
	if _, err := svc.Create(t.Context(), domaintest.Valid{{.N.Type}}Create()); errors.Is(err, domain.ErrNotImplemented) {
		t.Skip("rules 还没补足，见 NotImplemented 测试")
	}
{{- end}}
	req := map[string]any{
{{- range .Create}}
		{{q .Name}}: json.RawMessage(`{{.JSONSample}}`),
{{- end}}
	}
	body, _ := json.Marshal(req)
	code, created := do(t, e, http.MethodPost, prefix, string(body))
	if code != http.StatusCreated {
		t.Fatalf("创建 = %d %v", code, created)
	}
{{- if or .Admin .WebGet}}
	code, got := do(t, e, http.MethodGet, fmt.Sprintf("%s/%v", prefix, created["id"]), "")
	if code != http.StatusOK {
		t.Fatalf("详情 = %d %v", code, got)
	}
{{- else}}
	got := created
{{- end}}
	for k, v := range req {
		var want any
		_ = json.Unmarshal(v.(json.RawMessage), &want)
		if fmt.Sprint(got[k]) != fmt.Sprint(want) {
			t.Errorf("%s = %v, want %v", k, got[k], want)
		}
	}
	_ = svc
}
{{end}}
