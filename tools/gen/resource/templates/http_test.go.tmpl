func Test{{pascal .N.OpList}}(t *testing.T) {
	e, _, repo := newServer(t)
	for range 3 {
		if err := repo.Create(t.Context(), domaintest.Valid{{.N.Type}}()); err != nil {
			t.Fatal(err)
		}
	}
{{- if .Admin}}
	code, body := do(t, e, http.MethodGet, prefix+"?page=1&size=2", "")
	if items, _ := body["items"].([]any); code != http.StatusOK || body["total"] != float64(3) || len(items) != 2 {
		t.Errorf("列表 = %d %v", code, body)
	}
	if code, body := do(t, e, http.MethodGet, prefix+"?sort=nope", ""); code != http.StatusBadRequest {
		t.Errorf("不允许的排序 = %d %v, want 400", code, body)
	}
{{- else}}
	code, body := do(t, e, http.MethodGet, prefix+"?limit=2", "")
	if items, _ := body["items"].([]any); code != http.StatusOK || len(items) != 2 || body["next_cursor"] == nil {
		t.Errorf("列表 = %d %v", code, body)
	}
{{- end}}
}
{{end}}
