// 会返回的错误：{{range $i, $e := .Errors}}{{if $i}}、{{end}}{{$e.Var}}{{end}}。
{{- end}}
func (s *Service) checkRule{{.N}}Delete(ctx context.Context, id string) error {
	return ErrNotImplemented
