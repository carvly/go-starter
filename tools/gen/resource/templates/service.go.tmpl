{{- if .Whens}}
//
// 前置条件（按钮按它显隐）：{{range $i, $w := .Whens}}{{if $i}}，{{end}}{{$w.Field.Name}} 是 {{range $j, $v := $w.Values}}{{if $j}} 或 {{end}}{{$v}}{{end}}{{end}}；
// 写进实现里的同一条 SQL，不满足时返回 ErrInvalidState。
{{- end}}
func (s *Service) {{.Go}}(ctx context.Context, id string{{range .Input}}, {{camel .Name}} {{.GoType}}{{end}}) (*{{$.N.Type}}, error) {
	return nil, ErrNotImplemented
}
{{end}}
{{- end}}
