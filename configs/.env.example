# 复制为仓库根目录下的 .env（本地开发用 github.com/joho/godotenv 自动
# 加载），或者在 CI/生产环境里以真正的环境变量形式导出。
# 这里只放占位符——真实的密钥/密码不能提交进仓库。
#
# 标 [必需] 的字段不设置会导致 Load() 直接报错退出，不会静默用零值启动。

# ---- 通用 ----

# 只读，用于给日志/指标打环境标签，不做代码分支判断
APP_ENV=development
# debug/info/warn/error
LOG_LEVEL=info
# 日志 instance 字段，区分同一服务的多个实例；默认取主机名，同一台机器上跑多个实例时分别设置
# INSTANCE_ID=api-1

# ---- HTTP（仅 cmd/api 使用）----

HTTP_ADDR=:8080
# cmd/worker 的内部健康检查 + /metrics 端口，不发布到宿主机
HTTP_INTERNAL_ADDR=:9090
# 后台 server（/admin/v1）的监听地址，为空不启动；建议只绑内网或 localhost。
# 配置了地址时 HTTP_ADMIN_ORIGIN 必填：后台前端的 origin，形如 https://admin.example.com。
HTTP_ADMIN_ADDR=
HTTP_ADMIN_ORIGIN=
# api 的内部端口（网关鉴权的会话校验端点），为空不启动；只让网关能连到，不发布到宿主机。不能与 worker 的
# HTTP_INTERNAL_ADDR 相同（同一台机器会冲突）
HTTP_API_INTERNAL_ADDR=
HTTP_BODY_LIMIT_BYTES=2097152
HTTP_REQUEST_TIMEOUT=10s
# 生产环境必须显式打开（比如 31536000 = 1 年），本地用 HTTP 时保持 0
HTTP_HSTS_MAX_AGE=0
# 服务是否部署在受信任的反向代理/负载均衡后面——这个值不能凭感觉猜，
# 必须匹配真实部署拓扑
HTTP_TRUSTED_PROXY=false
# 收到停止信号后继续服务的排空期，默认 0。网关后的多实例部署必须 >= 网关 upstream 的
# keepalive_timeout + 1s（见 docs/agents/deploy-ci.md 的"裸机发布"）
HTTP_SHUTDOWN_DRAIN=0s
# 裸机部署：前台、后台端口继承 systemd 的 socket activation，初始化和依赖检查完成后通知 systemd 就绪。
# 打开时 HTTP_ADDR、HTTP_ADMIN_ADDR 必须写成 IP:端口（见 docs/agents/deploy-ci.md 的"裸机发布"）
HTTP_SOCKET_ACTIVATION=false
HTTP_GLOBAL_RATE_LIMIT_PER_SECOND=20
# /docs（Redoc）和 spec 原文（/openapi.yaml、后台 /admin.yaml）的开关，默认关闭。
# 本地开发和测试环境打开，生产环境保持 false
HTTP_API_DOCS_ENABLED=true
# trace 导出地址（OTLP/HTTP），为空时不导出、不建立连接，日志照样有 trace_id。
# 其余 OTEL_EXPORTER_OTLP_*（headers、超时）由 exporter 直接读
OTEL_EXPORTER_OTLP_ENDPOINT=

# [必需] 显式列出信任的前端域名，不用 "*"；docker-compose 本地联调用
# http://localhost:5173 这类前端开发端口，按实际情况改
CORS_ALLOW_ORIGINS=http://localhost:5173

# ---- 数据库（Postgres，[必需]）----

# api 与 worker 必须使用同一个 DSN
DB_DSN=postgres://app:app@localhost:5432/app?sslmode=disable
DB_MIN_CONNS=2
DB_MAX_CONNS=25
DB_MAX_CONN_LIFETIME=1h
DB_HEALTH_CHECK_PERIOD=1m

# ---- Redis（可选）：缓存 + 多实例共享的限流计数；不设置时缓存退回 Noop、限流按进程内存计数 ----

# REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=

# ---- 鉴权（JWT/Argon2id）----

# [必需] 至少 32 字节的随机字符串（短于 32 字节拒绝启动），用 `openssl rand -base64 32` 生成；
# 轮换步骤见 docs/agents/deploy-ci.md 的"配置"
JWT_SIGNING_KEY=changeme
# [必需] 当前签名密钥对应的 kid，密钥轮换时换一个新值
JWT_KEY_ID=default
# 密钥轮换期间保留旧密钥用于校验旧 token，格式 "kid1:secret1,kid2:secret2"（每把至少 32 字节，不能含当前
# kid，格式不对拒绝启动）；平时留空
# JWT_ADDITIONAL_KEYS=

# Argon2id 参数（基础设施配置，所有哈希密码的模块共用）——这里的默认值（64MB 内存、1 次迭代、
# 2 路并行）需要按部署环境实际可用内存和登录 QPS 压测调整，不是抄了就不用管的最终值
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=1
ARGON2_PARALLELISM=2

# ---- 后台员工（staff 模块）----
STAFF_SESSION_IDLE_TIMEOUT=30m
STAFF_SESSION_MAX_AGE=12h
STAFF_TEMP_PASSWORD_TTL=24h
# 操作日志保留期，默认 180 天
STAFF_AUDIT_RETENTION=4320h

# ---- 前台用户登录（微信各入口 + 会话）----

# [必需] 对外 API 的 origin，浏览器 OAuth 流程的 redirect_uri 由它和固定路径拼出，
# 第三方平台侧配置的回调地址必须和它一致
USER_PUBLIC_BASE_URL=https://api.example.com
# Origin 在这个名单内的请求，refresh token 只进 httpOnly cookie（响应体不含）；
# 名单外（App、小程序）走响应体。只列 web 前端的 origin
USER_COOKIE_DELIVERY_ORIGINS=https://app.example.com
# 会话各项时长；刷新宽限期只为网络重试准备，客户端必须串行刷新
USER_SESSION_MAX_AGE=720h
USER_SESSION_IDLE_TIMEOUT=168h
USER_ACCESS_TOKEN_TTL=15m
USER_REFRESH_GRACE_PERIOD=10s
USER_REAUTH_WINDOW=10m
# [可选] 每类设备（web、各小程序、App 的手机 / 平板）最多同时保留几个登录会话，新登录顶掉最久没用的；
# 被顶掉的设备收到 401 session_replaced。0 或留空表示不限制（默认）
USER_SESSION_SLOT_LIMIT=0
# [可选] 网关鉴权（docs/agents/auth.md 的"网关鉴权"，切换顺序见 docs/agents/deploy-ci.md）：OpenResty 调 api 内部端口的
# 会话校验端点换身份断言，后端只验证断言。session（默认）按 access token 查会话；gateway 时必须配
# GATEWAY_ASSERTION_PUBLIC_KEYS。单体部署用 session 即可
USER_AUTH_MODE=session
# 身份断言的密钥对（ES256/P-256）：openssl ecparam -name prime256v1 -genkey -noout -out k.pem，然后
#   私钥：openssl pkcs8 -topk8 -nocrypt -in k.pem -outform DER | base64 | tr -d '\n'
#   公钥：openssl ec -in k.pem -pubout -outform DER | base64 | tr -d '\n'
# 私钥和它的 kid 只在 user 服务上配置
USER_ASSERTION_SIGNING_KEY=
USER_ASSERTION_SIGNING_KID=
# 所有验证方用同一份的公钥清单，"kid1:公钥1,kid2:公钥2"；必须包含上面私钥对应的公钥（同一个 kid），否则启动失败
GATEWAY_ASSERTION_PUBLIC_KEYS=

# [可选] 微信登录入口的应用凭据，按产品需要组合：每个入口 appid 和 secret 成对配置
# 才启用，都留空就不启用，只配一半启动失败。subject 用 unionid，前提是启用的应用都
# 绑定到同一个开放平台账号（上线前完成，见 internal/modules/user/docs/user.md 的"微信平台要点"）
WECHAT_WEB_APP_ID=
WECHAT_WEB_SECRET=
WECHAT_MP_APP_ID=
WECHAT_MP_SECRET=
WECHAT_MINI_APP_ID=
WECHAT_MINI_SECRET=
WECHAT_APP_APP_ID=
WECHAT_APP_SECRET=
